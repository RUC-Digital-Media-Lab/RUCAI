DATA_ROOT=./data
UPLOAD_ROOT=./data/uploads
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ppl_rag
DB_USER=ppl
DB_PASSWORD=changeme
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
CHAT_MODEL=gemma3:12b
AUTH_USERNAME=frede
AUTH_PASSWORD=RUC_AI
AUTH_USERS_FILE=./data/auth_users.json
AUTH_TTL_SECONDS=43200

# Public access mode: reverse_ssh (recommended), cloudflare, none
ACCESS_MODE=reverse_ssh

# Reverse SSH tunnel (UCloud -> front server)
SERVER_HOST=212.27.13.34
SERVER_SSH_PORT=2111
SERVER_SSH_USER=frede
REMOTE_BIND_PORT=18011
REVERSE_TUNNEL_SESSION=rucai-revtunnel
REVERSE_TUNNEL_LOG=.logs/reverse_tunnel.log
PUBLIC_BASE_URL=https://rucai-ruc.dk

# Cloudflare fallback (only used if ACCESS_MODE=cloudflare or ENABLE_CLOUDFLARE_TUNNEL=1)
ENABLE_CLOUDFLARE_TUNNEL=0
CLOUDFLARE_TUNNEL_MODE=trycloudflare
CLOUDFLARE_TUNNEL_SESSION=rucai-cloudflare
CLOUDFLARE_TUNNEL_LOG=.logs/cloudflared.log
CLOUDFLARE_PUBLIC_URL_FILE=.logs/cloudflare_url.txt
APP_PORT=8011

# Ops monitor (GPU + health + tunnel status)
ENABLE_OPS_MONITOR=1
OPS_MONITOR_INTERVAL=15
OPS_MONITOR_SESSION=rucai-monitor
OPS_MONITOR_LOG=.logs/ops_monitor.csv
